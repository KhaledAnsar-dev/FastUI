<Project Sdk="Microsoft.NET.Sdk">

	<!-- ========================================================= -->
	<!-- Core Project Settings -->
	<!-- ========================================================= -->
	<PropertyGroup>
		<TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- NuGet Package Info -->
		<PackageId>FastUI.WinForms</PackageId>
		<Version>1.1.0</Version>
		<Authors>Khaled Ansar</Authors>
		<Company>Khaled Ansar</Company>

		<Description>
			FastUI is a lightweight UI toolkit for creating clean, modern WinForms applications.
			Built for developers targeting the .NET Windows Forms platform.
		</Description>

		<PackageTags>
			fastui; csharp; dotnet; winforms; ui; ui-controls; custom-controls;
			modern-ui; lightweight-ui; winforms-toolkit; ui-toolkit; desktop-ui
		</PackageTags>

		<RepositoryUrl>https://github.com/KhaledAnsar-dev/FastUI</RepositoryUrl>
		<PackageProjectUrl>https://github.com/KhaledAnsar-dev/FastUI</PackageProjectUrl>

		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>

		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<LangVersion>latest</LangVersion>

	</PropertyGroup>

	<!-- ========================================================= -->
	<!-- Nullable Reference Types (Only for .NET 8+) -->
	<!-- ========================================================= -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
		<Nullable>enable</Nullable>
	</PropertyGroup>
	
	<!-- ========================================================= -->
	<!-- .NET Framework 4.8 Resource Fix -->
	<!-- ========================================================= -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
	</PropertyGroup>

	<!-- ========================================================= -->
	<!-- Resource support for net48 (safe for all targets) -->
	<!-- ========================================================= -->
	<ItemGroup>
		<PackageReference Include="System.Resources.Extensions" Version="8.0.0">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>


	<!-- ========================================================= -->
	<!-- NuGet Content -->
	<!-- ========================================================= -->
	<ItemGroup>
		<None Include="LICENSE" Pack="true" PackagePath="" />
		<None Include="README.md" Pack="true" PackagePath="" />
		<None Include="icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<!-- ========================================================= -->
	<!-- Resources -->
	<!-- ========================================================= -->
	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
